# Copy to .env and fill in. Everything here is optional — the site runs with
# none of it set, it just does less.

# ---------------------------------------------------------------------------
# Launch countdown
# ---------------------------------------------------------------------------
# ISO 8601 with an explicit offset. Leave unset and the page shows a build
# status instead of a countdown, which is the right call until the date is real.
# A countdown that resets when it expires does more damage than no countdown.
# VITE_LAUNCH_DATE=2026-09-15T10:00:00+04:00

# ---------------------------------------------------------------------------
# Email capture
# ---------------------------------------------------------------------------
# POST endpoint receiving { "email": string, "locale": "en"|"az", "source": string }.
# Any 2xx counts as success. Unset and the form falls back to a mailto: link
# rather than pretending to have stored anything.
# VITE_SUBSCRIBE_ENDPOINT=https://backend.claradix.com/subscribe

# ---------------------------------------------------------------------------
# Analytics — "none" | "plausible" | "umami" | "ga4"
# ---------------------------------------------------------------------------
# Default is none: zero third-party JavaScript ships until this is set.
# Plausible/Umami are cookieless, need no consent banner, and cost ~1KB against
# GA4's ~45KB. For a page whose whole point is speed, that is not a close call.
VITE_ANALYTICS_PROVIDER=none
# VITE_ANALYTICS_DOMAIN=claradix.com
# VITE_ANALYTICS_SCRIPT=https://plausible.io/js/script.tagged-events.js
# VITE_ANALYTICS_ID=
